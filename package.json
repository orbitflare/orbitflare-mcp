{
  "name": "@orbitflare/mcp",
  "version": "0.2.0",
  "description": "OrbitFlare MCP Server: Solana RPC, DAS, transaction history, Jetstream streaming, Apex transaction landing and OrbitFlare account tools for AI assistants, built on @orbitflare/sdk",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "orbitflare-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -p \"'export const VERSION = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "orbitflare",
    "solana",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "rpc",
    "das",
    "jetstream",
    "yellowstone",
    "apex",
    "shredstream",
    "blockchain",
    "web3"
  ],
  "author": "OrbitFlare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitflare/orbitflare-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/orbitflare/orbitflare-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.orbitflare.com",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@orbitflare/sdk": "^0.5.1",
    "@solana-program/system": "^0.16.0",
    "@solana/kit": "^8.5.0",
    "bs58": "^6.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "system-prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  }
}
