{
  "name": "orbitflare-mcp",
  "version": "0.1.0",
  "description": "OrbitFlare MCP Server — Solana RPC, streaming, staking, and account tools for AI assistants, powered by OrbitFlare's Shredstream-optimized infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "orbitflare-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node -p \"'export const VERSION = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "orbitflare",
    "solana",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "rpc",
    "jetstream",
    "yellowstone",
    "shredstream",
    "blockchain",
    "web3"
  ],
  "author": "OrbitFlare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orbitflare/orbitflare-mcp"
  },
  "homepage": "https://docs.orbitflare.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana-program/stake": "^0.6.1",
    "@solana-program/system": "^0.12.0",
    "@solana/kit": "^6.8.0",
    "bs58": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "system-prompts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
